# ============================================================================
# Baraka Fish HD - variables d'environnement (exemple)
# Copier vers .env a la racine du monorepo puis renseigner les vraies valeurs.
# ============================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Base de donnees PostgreSQL -------------------------------------------
# Doit correspondre au service "db" de docker-compose.yml
DATABASE_URL=postgresql://baraka:baraka@localhost:5432/baraka_fish

# --- Authentification ------------------------------------------------------
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Fournisseurs (interfaces modulables) ----------------------------------
# OTP : console | sms | whatsapp
OTP_PROVIDER=console
# Paiement : mock | aggregator (Wave / Orange Money via PayDunya, PayTech, CinetPay...)
PAYMENT_PROVIDER=mock
# Secret HMAC de verification des webhooks de paiement (au moins 16 caracteres)
PAYMENT_WEBHOOK_SECRET=change-me-with-a-long-random-webhook-secret
# URL publique de l'API (redirections de paiement, retour apres paiement)
PUBLIC_API_URL=http://localhost:3000
# Notifications : console | sms | whatsapp
NOTIFICATION_PROVIDER=console

# --- Stockage des photos : local | s3 | cloudinary -------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Stockage S3 compatible (si STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudinary (si STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
